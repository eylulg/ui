{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "declarationMap": false,
    "outDir": "dist",
    "rootDir": "src",
    "types": []
  },
  "include": ["src"],
  "exclude": [
    "src/**/*.stories.tsx",
    "src/**/__tests__",
    "src/test-utils",
    "src/**/*.mdx",
    "src/docs"
  ]
}
