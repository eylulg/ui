[
  {
    "name": "Full index (all 34 components, deps excluded)",
    "path": "dist/index.js",
    "import": "*",
    "ignore": [
      "react",
      "react-dom",
      "react-aria-components",
      "tailwind-merge",
      "lucide-react",
      "@internationalized/date"
    ],
    "limit": "13 kB"
  },
  {
    "name": "Button only (tree shaken)",
    "path": "dist/index.js",
    "import": "{ Button }",
    "ignore": [
      "react",
      "react-dom",
      "react-aria-components",
      "tailwind-merge",
      "lucide-react",
      "@internationalized/date"
    ],
    "limit": "1 kB"
  },
  {
    "name": "Per component entry: Dialog",
    "path": "dist/components/Dialog/index.js",
    "import": "{ Dialog }",
    "ignore": ["react", "react-dom", "react-aria-components", "tailwind-merge", "lucide-react"],
    "limit": "1.5 kB"
  },
  {
    "name": "Per component entry: Table",
    "path": "dist/components/Table/index.js",
    "import": "{ Table, TableHeader, Column, TableBody, Row, Cell }",
    "ignore": ["react", "react-dom", "react-aria-components", "tailwind-merge", "lucide-react"],
    "limit": "2.5 kB"
  },
  {
    "name": "Per component entry: CommandPalette",
    "path": "dist/components/CommandPalette/index.js",
    "import": "{ CommandPalette }",
    "ignore": ["react", "react-dom", "react-aria-components", "tailwind-merge", "lucide-react"],
    "limit": "2.5 kB"
  },
  {
    "name": "Chrome: full TopNav with switcher and toggle",
    "path": "dist/chrome/index.js",
    "import": "{ TopNav, ProjectSwitcher, ThemeToggle }",
    "ignore": ["react", "react-dom", "react-aria-components", "tailwind-merge", "lucide-react"],
    "limit": "5 kB"
  },
  {
    "name": "Chrome: server safe parts",
    "path": "dist/chrome/index.js",
    "import": "{ AppShell, SiteFooter, BrandMark, themeInitScript }",
    "ignore": ["react", "react-dom", "react-aria-components", "tailwind-merge", "lucide-react"],
    "limit": "2.5 kB"
  },
  {
    "name": "Theme variant matrix",
    "path": "dist/styles/themes/variants.js",
    "import": "{ variants }",
    "limit": "3 kB"
  },
  {
    "name": "Stylesheet",
    "path": "dist/styles.css",
    "limit": "9 kB"
  },
  {
    "name": "One theme variant file",
    "path": "dist/themes/workspace.css",
    "limit": "1 kB"
  },
  {
    "name": "Plain tokens (no Tailwind)",
    "path": "dist/tokens.css",
    "limit": "2.5 kB"
  },
  {
    "name": "Optional Inter loader",
    "path": "dist/fonts.css",
    "limit": "0.3 kB"
  }
]
