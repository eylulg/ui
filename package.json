  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "storybook dev -p 6006",
    "build": "vite build && tsc -p tsconfig.build.json && npm run build:css",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "size": "size-limit",
    "measure": "jiti scripts/measure-bundles.ts",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "semantic-release": "semantic-release",
    "build:css": "tailwindcss -i src/styles/index.css -o dist/styles.css --minify && cp src/styles/theme.css src/styles/fonts.css src/styles/reset.css dist/ && jiti scripts/build-tokens.ts && mkdir -p dist/themes && cp src/styles/themes/*.css dist/themes/",
    "themes": "jiti scripts/generate-themes.ts",
    "contrast": "jiti scripts/contrast.ts",
    "check:focus": "jiti scripts/check-focus-ring.ts",
    "knip": "knip",
    "prepare": "husky"
  },
  "peerDependencies": {
    "@fontsource-variable/inter": "^5.0.0",
